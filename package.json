{
  "name": "agent-university-qm-deployment",
  "version": "0.0.0",
  "dependencies": {
    "@yc-software/qm": "0.1.12",
    "next": "^15.5.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:contracts && npm run test:unit && npm run test:ts && npm run test:compile",
    "test:contracts": "python3 scripts/check_contracts.py",
    "test:unit": "python3 -m unittest discover -s tests",
    "test:compile": "python3 -m py_compile scripts/*.py tests/*.py",
    "verify:fixture": "python3 scripts/verify_company.py demo/fixtures/company.json",
    "qm": "qm",
    "check": "qm check",
    "plan": "qm plan",
    "deploy": "qm up",
    "status": "qm status",
    "conformance": "qm conformance --static",
    "test:ts": "node --test tests/*.test.ts",
    "certify": "node scripts/certify.ts",
    "registry": "node scripts/registry.ts",
    "swarm": "node scripts/swarm.ts",
    "tournament": "node scripts/tournament.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
