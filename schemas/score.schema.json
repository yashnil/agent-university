{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "score.schema.json",
  "title": "score.json",
  "description": "Pipeline stage 3 (Score Fit). v0 PLACEHOLDER, owned by feat/certification. Inputs: company.json and repo_analysis.json. score is 0-100; it should equal the weighted mean of rubric scores (weights sum to 1), which a verifier may check.",
  "type": "object",
  "required": ["company_name", "score", "rubric", "inputs"],
  "properties": {
    "company_name": { "type": "string", "minLength": 1 },
    "score": { "type": "number", "minimum": 0, "maximum": 100 },
    "rubric": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["criterion", "weight", "score", "rationale"],
        "properties": {
          "criterion": { "type": "string", "minLength": 1 },
          "weight": { "type": "number", "minimum": 0, "maximum": 1 },
          "score": { "type": "number", "minimum": 0, "maximum": 100 },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["company.json", "repo_analysis.json"] }
    }
  }
}
