{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verification-result.schema.json",
  "title": "VerificationResult",
  "description": "Output of a deterministic verifier. passed is true exactly when every check passed. Check names are stable snake_case ids; message is human-readable detail.",
  "type": "object",
  "required": ["passed", "checks"],
  "properties": {
    "passed": { "type": "boolean" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "passed"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "passed": { "type": "boolean" },
          "message": { "type": "string" }
        }
      }
    }
  }
}
